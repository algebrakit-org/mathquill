# >>> harden-npmrc supply-chain protections >>>
# 7-day release-age cooldown — blocks installing freshly published versions.
# npm 11.5+ uses days:
min-release-age=7
# npm exclude (npm/cli#9534, npm >=11.17.0): list of names or minimatch globs exempt from the cooldown
min-release-age-exclude=@algebrakit-org/*
# <<< harden-npmrc supply-chain protections <<<
